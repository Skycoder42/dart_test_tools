{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Application preset (lockfile committed, all updates; majors get their own PR each)",
  "extends": [
    "github>Skycoder42/dart_test_tools//renovate/base"
  ],
  "postUpgradeTasks": {
    "commands": [
      "renovate-post-upgrade --mode application"
    ],
    "executionMode": "branch",
    "fileFilters": [
      "**/*"
    ],
    "dataFileTemplate": "[{{#each upgrades}}{\"manager\":\"{{{manager}}}\",\"depName\":\"{{{depName}}}\",\"packageFile\":\"{{{packageFile}}}\",\"depType\":\"{{{depType}}}\",\"currentValue\":\"{{{currentValue}}}\",\"newValue\":\"{{{newValue}}}\",\"updateType\":\"{{{updateType}}}\"}{{#unless @last}},{{/unless}}{{/each}}]"
  },
  "packageRules": [
    {
      "description": "Give new pub releases (packages and SDKs) some time before they are used",
      "matchManagers": [
        "pub"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Majors (deps, dev deps and SDK) get their own PR per dependency",
      "matchManagers": [
        "pub"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "description": "0.x minors are breaking in pub: same treatment as majors",
      "matchManagers": [
        "pub"
      ],
      "matchDatasources": [
        "dart"
      ],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": null
    }
  ]
}
