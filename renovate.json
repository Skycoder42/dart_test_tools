{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Skycoder42/dart_test_tools//renovate/library"
  ],
  "enabledManagers": [
    "pub",
    "npm",
    "custom.regex"
  ],
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "customManagers": [
    {
      "description": "Flutter SDK of the Flutter sbx kit (the matching Dart SDK is derived by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbx/flutter/flutter\\.yaml$/"
      ],
      "matchStrings": [
        "flutterVersion:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "flutter",
      "datasourceTemplate": "flutter-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "dart-lang/skills agent skills of the Flutter sbx kit (the skill list is regenerated by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbx/flutter/flutter\\.yaml$/"
      ],
      "matchStrings": [
        "dartSkillsRef:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "dart-lang/skills",
      "packageNameTemplate": "https://github.com/dart-lang/skills",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "description": "flutter/agent-plugins agent skills of the Flutter sbx kit (the skill list is regenerated by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbx/flutter/flutter\\.yaml$/"
      ],
      "matchStrings": [
        "flutterSkillsRef:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "flutter/agent-plugins",
      "packageNameTemplate": "https://github.com/flutter/agent-plugins",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "description": "Digest-pinned BuildKit frontends and base images of the sbx kits",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbx/[^/]+/[^/]+\\.(yaml|dockerfile)$/"
      ],
      "matchStrings": [
        "# syntax=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
        "ARG [A-Z_]+=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "kit-tck used to validate the sbx kits (the checksum of the linux_amd64 archive is looked up in the new release)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbx/tool/install-kit-tck\\.sh$/"
      ],
      "matchStrings": [
        "KIT_TCK_TAG=(?<currentValue>\\S+)\\s*\\nKIT_TCK_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "docker/sandbox-kit-spec",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "description": "sbx used to sign the sbx kits, from Docker's apt repository (the workflow installs exactly this package version)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/sbx-kits\\.yml$/"
      ],
      "matchStrings": [
        "SBX_VERSION:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "docker-sbx",
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://download.docker.com/linux/ubuntu?suite=noble&components=stable&binaryArch=amd64"
    }
  ],
  "packageRules": [
    {
      "description": "Node only moves to even (LTS) majors",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      "description": "Node majors get their own PR after dashboard approval",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "node",
      "groupSlug": "node",
      "group": {
        "branchTopic": "node"
      },
      "prTitleStrict": true
    },
    {
      "description": "Give new Renovate releases some time before the workflow runs them",
      "matchPackageNames": [
        "renovate"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The Flutter sbx kit only moves to stable Flutter releases that had some time to settle",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "flutter-version"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Everything of the sbx kits (kits, their tools and the kit workflow) in its own PR, so only it validates and publishes the kits",
      "matchFileNames": [
        "sbx/**",
        ".github/workflows/sbx-kits.yml"
      ],
      "groupName": "sbx kits",
      "groupSlug": "sbx",
      "group": {
        "branchTopic": "sbx"
      },
      "prTitleStrict": true
    },
    {
      "description": "New frontend grammar or syntax versions of the sbx kits need a manual migration: their own PR after dashboard approval (digest updates stay in the sbx kits PR)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "docker/sandbox-kit",
        "docker/dockerfile"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "sbx kit frontends",
      "groupSlug": "sbx-frontends",
      "group": {
        "branchTopic": "sbx-frontends"
      },
      "prTitleStrict": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Give new kit-tck releases some time to settle",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchDepNames": [
        "docker/sandbox-kit-spec"
      ],
      "minimumReleaseAge": "3 days"
    }
  ]
}
