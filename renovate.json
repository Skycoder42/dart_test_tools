{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Skycoder42/dart_test_tools//renovate/library"],
  "enabledManagers": ["pub", "npm"],
  "packageRules": [
    {
      "description": "Node only moves to even (LTS) majors",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      "description": "Node majors get their own PR after dashboard approval",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "node",
      "groupSlug": "node",
      "group": { "branchTopic": "node" },
      "prTitleStrict": true
    },
    {
      "description": "Give new Renovate releases some time before the workflow runs them",
      "matchPackageNames": ["renovate"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
