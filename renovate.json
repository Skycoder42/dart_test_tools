{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Skycoder42/dart_test_tools//renovate/library"],
  "enabledManagers": ["pub", "npm", "custom.regex"],
  "postUpdateOptions": ["npmDedupe"],
  "customManagers": [
    {
      "description": "Flutter SDK of the Flutter sbx kit (the matching Dart SDK is derived by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": ["/^sbx/flutter/flutter\\.yaml$/"],
      "matchStrings": [
        "flutterVersion:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "flutter",
      "datasourceTemplate": "flutter-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "dart-lang/skills agent skills of the Flutter sbx kit (the skill list is regenerated by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": ["/^sbx/flutter/flutter\\.yaml$/"],
      "matchStrings": [
        "dartSkillsRef:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "dart-lang/skills",
      "packageNameTemplate": "https://github.com/dart-lang/skills",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "description": "flutter/agent-plugins agent skills of the Flutter sbx kit (the skill list is regenerated by the pre-build command)",
      "customType": "regex",
      "managerFilePatterns": ["/^sbx/flutter/flutter\\.yaml$/"],
      "matchStrings": [
        "flutterSkillsRef:\\s*\\n(?:\\s*#.*\\n)*\\s*default:\\s*(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "flutter/agent-plugins",
      "packageNameTemplate": "https://github.com/flutter/agent-plugins",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "Node only moves to even (LTS) majors",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "allowedVersions": "/^v?\\d*[02468]\\./"
    },
    {
      "description": "Node majors get their own PR after dashboard approval",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "node",
      "groupSlug": "node",
      "group": { "branchTopic": "node" },
      "prTitleStrict": true
    },
    {
      "description": "Give new Renovate releases some time before the workflow runs them",
      "matchPackageNames": ["renovate"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The Flutter sbx kit only moves to stable Flutter releases that had some time to settle",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["flutter-version"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "minimumReleaseAge": "3 days"
    }
  ]
}
